# =========================================================
# site-brand (vodnavi.jp 公式ブランドサイト) — 環境変数テンプレート
# 使い方:
#   cp .env.example .env.local
# その上で各値を埋めてください。
# NEXT_PUBLIC_* はクライアントバンドルに含まれるので、
# 公開しても問題ない値だけを入れること。
#
# 監査連携: scripts/audit-google-tools.mjs の envSchemas 突合対象。
# layout.tsx が参照する変数はここで宣言しておくこと（Vercel 投入時の
# スキーマソースになる）。
# =========================================================

# ---------- Google Analytics 4 ----------
# Measurement ID (例: G-XXXXXXXXXX)。未設定なら GA タグは挿入されない。
# vodnavi-group 統合プロパティ: G-GG7JV9MJRW
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ---------- Google Tag Manager ----------
# Container ID (例: GTM-XXXXXXX)。未設定なら GTM コンテナは挿入されない。
# Vercel の Production scope に投入すること (Preview だけだと本番に出ない)。
NEXT_PUBLIC_GTM_ID=
