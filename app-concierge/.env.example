# =========================================================
# app-concierge — 環境変数テンプレート
# 使い方:
#   cp .env.example .env.local
# その上で各値を埋めてください。
# 秘匿値（API キー等）は絶対にコミットしないこと。
# NEXT_PUBLIC_* はクライアントバンドルに含まれるので、
# 公開しても問題ない値だけを入れること。
# =========================================================

# ---------- DMM / FANZA Webservice API v3.0 ----------
# 取得元: https://affiliate.dmm.com/api/
# アフィリエイト ID は通常 "-990" や "-996" などで終わる。
DMM_API_ID=""
DMM_AFFILIATE_ID=""

# 案A (3-ID 並列識別仕様、commit 5156207 確定):
# - NEXT_PUBLIC_FANZA_AFFILIATE_ID = 成約用 (app-concierge UI) 副サイト ID
# - 既定値は "moterist-004"。本番 Vercel env でも同値を設定すること。
# - url-builder.ts は process.env.NEXT_PUBLIC_FANZA_AFFILIATE_ID ?? DMM_AFFILIATE_ID の順で解決。
NEXT_PUBLIC_FANZA_AFFILIATE_ID="moterist-004"

# ---------- Anthropic API ----------
# /concierge の AI コンシェルジュで使用。サーバ側でのみ参照されるため
# NEXT_PUBLIC_ プレフィクスは付けない（クライアントへは漏らさない）。
ANTHROPIC_API_KEY=""

# ---------- 公開 URL ----------
# canonical / sitemap / OG で使用。
# 開発: http://localhost:3000
# 本番: 実際のデプロイ先（例: https://app.vodnavi.jp）
NEXT_PUBLIC_SITE_URL=""

# ---------- Google Analytics 4 ----------
# Measurement ID (例: G-XXXXXXXXXX)。未設定なら GA タグは挿入されない。
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# ---------- Google Tag Manager ----------
# Container ID (例: GTM-XXXXXXX)。未設定なら GTM コンテナは挿入されない。
# layout.tsx の <GoogleTagManager> はこの値が空 / NODE_ENV != production の時
# null を返すため、本番ビルドへの非本番混入経路は無い。
# Vercel の Production scope に投入すること (Preview に入れても本番には反映されない)。
NEXT_PUBLIC_GTM_ID=""

# ---------- Make.com Webhook ----------
# お問い合わせフォームの送信先。
# 未設定の場合はサーバーログに記録するだけのモードに自動切替される。
NEXT_PUBLIC_MAKE_WEBHOOK_URL=""
