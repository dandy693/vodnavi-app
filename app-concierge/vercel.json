{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "hnd1"
  ],
  "ignoreCommand": "sh scripts/vercel-ignore-build.sh",
  "github": {
    "silent": true
  },
  "crons": [
    {
      "path": "/api/cron/snapshot-prices",
      "schedule": "0 21 * * *"
    },
    {
      "path": "/api/cron/snapshot-prices",
      "schedule": "0 5 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/wordpress-sango-review/:path*",
      "destination": "https://site-brand-vodnavi.vercel.app/wordpress-sango-review/:path*",
      "has": [
        {
          "type": "host",
          "value": "vodnavi.jp"
        }
      ]
    },
    {
      "source": "/u-next-second-free-trial/:path*",
      "destination": "https://site-brand-vodnavi.vercel.app/u-next-second-free-trial/:path*",
      "has": [
        {
          "type": "host",
          "value": "vodnavi.jp"
        }
      ]
    }
  ]
}
