# DMM/FANZA Webservice API v3.0 credentials
# Get them from https://affiliate.dmm.com/api/
# Affiliate ID typically ends with "-990" or "-996" etc.
DMM_API_ID="your_api_id_here"
DMM_AFFILIATE_ID="your_affiliate_id-990"

# Public site URL — used for canonical / sitemap / OG.
# Local dev: http://localhost:3000. Production: your deployed domain.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Make.com Webhook URL — お問い合わせフォームの送信先
# 未設定の場合はサーバーログに記録するだけのモードに自動切替されます
NEXT_PUBLIC_MAKE_WEBHOOK_URL="https://hook.eu1.make.com/your-webhook-id"

# Google Analytics 4 Measurement ID (G-XXXXXXXXXX)
# 未設定の場合は GA タグは挿入されません
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# Anthropic API key — /concierge の AI コンシェルジュで使用
# サーバー側でのみ参照されるため NEXT_PUBLIC_ プレフィクスは付けない
ANTHROPIC_API_KEY="sk-ant-api03-xxxxxxxx"

# 公開URL（SEO のために canonical / OG / sitemap で使用）
# 本番は Vercel の Production URL を、開発時は http://localhost:3000 を指定
NEXT_PUBLIC_SITE_URL="https://your-domain.example.com"
