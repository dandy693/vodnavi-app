  "rules": [
    {
      "name": "E28-1 PerplexityBot rate limit",
      "description": "CSO裁定 2026-09-21 ①: PerplexityBot UA を 60s/IP で 30 req に制限（超過は deny）。LLMO 方針は維持。7日後に再裁定",
      "active": true,
      "action": {
        "mitigate": {
          "action": "rate_limit",
          "rateLimit": {
            "limit": 30,
            "action": "deny",
            "window": 60,
            "algo": "fixed_window",
            "keys": [
              "ip"
            ]
          }
        }
      },
      "id": "rule_e28_1_perplexity_bot_rate_limit_KydRrK",
      "conditionGroup": [
        {
          "conditions": [
            {
              "type": "user_agent",
              "op": "sub",
              "value": "PerplexityBot"
            }
          ]
        }
      ],
      "valid": true,
      "validationErrors": null
    },
    {
      "name": "E28-2 concierge non-browser deny",
      "description": "CSO裁定 2026-09-21 ②: /concierge の非ブラウザUAを deny（Googlebot/bingbot/Google-InspectionTool はページ本体のみ許可）。/api/concierge は全非ブラウザUAを deny（除外は healthcheck の固定UA vodnavi-healthcheck/1 のみ）",
      "active": true,
      "action": {
        "mitigate": {
          "action": "deny"
        }
      },
      "id": "rule_e28_2_concierge_non_browser_deny_KQwbUo",
      "conditionGroup": [
        {
          "conditions": [
            {
              "type": "path",
              "op": "pre",
              "value": "/concierge"
            },
            {
              "type": "user_agent",
              "op": "re",
              "value": "[Bb]ot|[Cc]rawler|[Ss]pider|[Cc]url|[Pp]ython|[Ss]crapy|[Hh]ttp[Cc]lient|[Jj]ava/|[Gg]o-http|[Ww]get"
            },
            {
              "op": "sub",
              "neg": true,
              "type": "user_agent",
              "value": "Googlebot"
            },
            {
              "op": "sub",
              "neg": true,
              "type": "user_agent",
              "value": "bingbot"
            },
            {
              "op": "sub",
              "neg": true,
              "type": "user_agent",
              "value": "vodnavi-affiliate-guard"
            },
            {
              "op": "sub",
              "neg": true,
              "type": "user_agent",
              "value": "Google-InspectionTool"
            }
          ]
        },
        {
          "conditions": [
            {
              "type": "path",
              "op": "pre",
              "value": "/concierge"
            },
            {
              "op": "sub",
              "neg": true,
              "type": "user_agent",
              "value": "Mozilla/5.0 ("
            },
            {
              "op": "sub",
              "neg": true,
              "type": "user_agent",
              "value": "Googlebot"
            },
            {
              "op": "sub",
              "neg": true,
              "type": "user_agent",
              "value": "bingbot"
            },
            {
              "op": "sub",
              "neg": true,
              "type": "user_agent",
              "value": "vodnavi-affiliate-guard"
            },
            {
              "op": "sub",
              "neg": true,
              "type": "user_agent",
              "value": "Google-InspectionTool"
            }
          ]
        },
        {
          "conditions": [
            {
              "type": "path",
              "op": "pre",
              "value": "/api/concierge"
            },
            {
              "type": "user_agent",
              "op": "re",
              "value": "[Bb]ot|[Cc]rawler|[Ss]pider|[Cc]url|[Pp]ython|[Ss]crapy|[Hh]ttp[Cc]lient|[Jj]ava/|[Gg]o-http|[Ww]get"
